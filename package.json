{
  "name": "gdd-studio",
  "private": true,
  "version": "0.1.24",
  "description": "GDD Studio — local-first game design documentation desktop app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:mood-crop": "node scripts/verify-mood-crop-style.mjs",
    "tauri": "tauri",
    "package:portable": "node scripts/package-windows-portable.mjs",
    "build:portable": "npm run tauri -- build --config src-tauri/tauri.portable.conf.json && npm run package:portable"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/extension-font-family": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@xyflow/react": "^12.12.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.67.0",
    "nspell": "^2.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiptap-pagination-plus": "^2.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  }
}
