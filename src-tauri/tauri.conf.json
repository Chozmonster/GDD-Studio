{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDD Studio",
  "version": "0.1.0",
  "identifier": "com.gddstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GDD Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgOTNCM0YyNzBBMDMwMTQ1QgpSV1JiRkRDZ2NQS3prL1RoMnYxZmdxZmorVWJ6MVhpUG1wd1dBS2RJc0kzMktIYXV1Tjh3L3FpbAo=",
      "endpoints": [
        "https://github.com/Chozmonster/GDD-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
