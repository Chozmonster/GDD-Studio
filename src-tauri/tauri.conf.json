{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDD Studio",
  "version": "0.1.18",
  "identifier": "com.gddstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GDD Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**/*",
            "$APPLOCALDATA/**/*",
            "$RESOURCE/**/*",
            "$DOCUMENT/**/*",
            "$DESKTOP/**/*",
            "$DOWNLOAD/**/*",
            "$HOME/Documents/**/*",
            "$HOME/GDD Studio Projects/**/*"
          ],
          "deny": [
            "$HOME/.ssh/**/*",
            "$HOME/.gnupg/**/*",
            "**/.ssh/**/*",
            "**/.gnupg/**/*",
            "**/id_rsa*",
            "**/id_ed25519*",
            "**/id_ecdsa*"
          ]
        }
      }
    }
  },
  "mainBinaryName": "gdd-studio",
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NDg1QThDOEQ2MTIxQkUKUldTK0lXR05qRnBJcVQ4YXRFempyUjRpMU1nTWtNQ2NuckFNUVpVbHZMNURNL29Vci9GTFVHSmYK",
      "endpoints": [
        "https://github.com/Chozmonster/GDD-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
